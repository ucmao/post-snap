# Server Configuration
PORT=3008
HOST=0.0.0.0

# Base URL for public access (used for generated image links)
# e.g., http://localhost:3008 or https://your-domain.com
BASE_URL=http://localhost:3008

# Image Storage Options: 'local' | 'base64'
DEFAULT_IMAGE_STORAGE=local

# Uploads directory
UPLOADS_DIR=./uploads

# Max download image size in bytes (default 10MB)
MAX_IMAGE_SIZE_BYTES=10485760

# Max images to download per article when upload_images=true
MAX_IMAGES_PER_ARTICLE=100

# Request Timeout (ms)
REQUEST_TIMEOUT=15000

# ---------- Security (公网部署务必配置) ----------
# API 密钥，多个用逗号分隔。留空则不鉴权（仅限本地开发）
# 调用时通过 Header `X-API-Key: <key>` 或 `Authorization: Bearer <key>` 或 Query `api_key=<key>` 传入
API_KEY=

# 每个 IP 每分钟最多请求次数（/api/v1/extract），0 = 不限流
RATE_LIMIT_PER_MINUTE=30

# 允许跨域的前端来源，多个用逗号分隔；留空 = 允许所有来源
# e.g. https://admin.example.com,http://localhost:5173
CORS_ORIGINS=

# 部署在 Nginx / 负载均衡之后时设为 true，以便按真实客户端 IP 限流
TRUST_PROXY=false

# 是否允许抓取内网 / 私有地址（127.0.0.1、10.x、192.168.x、云元数据地址等）
# 公网部署请保持 false，否则存在 SSRF 风险
ALLOW_PRIVATE_NETWORK=false

# Optional: Platform Cookies for Private/Login-Only Articles
# 知乎 Cookie (在浏览器登录知乎后，从控制台拷贝 z_c0="..."; 或完整 Cookie 粘贴在此)
ZHIHU_COOKIE=
