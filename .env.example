# Server Configuration
PORT=3000
HOST=0.0.0.0

# Base URL for public access (used for generated image links)
# e.g., http://localhost:3000 or https://your-domain.com
BASE_URL=http://localhost:3000

# Image Storage Options: 'local' | 'base64'
DEFAULT_IMAGE_STORAGE=local

# Uploads directory
UPLOADS_DIR=./uploads

# Max download image size in bytes (default 10MB)
MAX_IMAGE_SIZE_BYTES=10485760

# Request Timeout (ms)
REQUEST_TIMEOUT=15000

# Optional: Platform Cookies for Private/Login-Only Articles
# 知乎 Cookie (在浏览器登录知乎后，从控制台拷贝 z_c0="..."; 或完整 Cookie 粘贴在此)
ZHIHU_COOKIE=
# 豆瓣 Cookie (用于突破创作者仅登录可见日记)
DOUBAN_COOKIE=
# 51CTO Cookie (用于跳过 EdgeOne 人机验证盾)
CTO51_COOKIE=
