# 服务基础配置
PORT=3008
HOST=0.0.0.0

# 外部访问的基础域名/URL（用于拼接生成的本地图片外链）
# 例如：http://localhost:3008 或 https://your-domain.com
BASE_URL=http://localhost:3008

# 默认图片存储方式：'local'（保存到本地文件并提供访问外链）| 'base64'（转为 Base64 Data URL 内联）
DEFAULT_IMAGE_STORAGE=local

# 本地图片上传保存目录
UPLOADS_DIR=./uploads

# 单张图片最大下载大小限制（字节，默认 10MB = 10485760）
MAX_IMAGE_SIZE_BYTES=10485760

# 单篇文章最大允许下载图片数量（当 upload_images=true 时生效，防止异常页面刷满磁盘）
MAX_IMAGES_PER_ARTICLE=100

# 网络请求超时时间（毫秒，默认 15000ms = 15秒）
REQUEST_TIMEOUT=15000

# ---------- 安全配置（公网部署务必按需配置） ----------
# API 密钥，多个用英文逗号分隔。留空则不开启鉴权（仅建议在本地开发时留空）
# 调用时可通过 Header `X-API-Key: <key>`、`Authorization: Bearer <key>` 或 Query 参数 `api_key=<key>` 传入
API_KEY=

# 每个 IP 每分钟最多请求次数（针对 /api/v1/extract 接口），设为 0 表示不限流
RATE_LIMIT_PER_MINUTE=30

# 允许跨域的前端来源，多个用英文逗号分隔；留空则允许所有来源跨域
# 例如：https://admin.example.com,http://localhost:5173
CORS_ORIGINS=

# 是否处于反向代理之后（如部署在 Nginx、Caddy、Cloudflare 或负载均衡之后时设为 true，以便正确获取客户端真实 IP 进行限流）
TRUST_PROXY=false

# 是否允许抓取内网 / 私有网络地址（如 127.0.0.1、10.x、192.168.x、云元数据地址 169.254.169.254 等）
# 公网部署务必保持 false，以防范 SSRF 内网探测攻击
ALLOW_PRIVATE_NETWORK=false

# ---------- 平台特定配置（可选） ----------
# 知乎 Cookie（在浏览器登录知乎后，从开发者工具控制台或请求头中复制 z_c0="..."; 或完整 Cookie 粘贴在此，抓取专栏/回答可防 403 反爬）
ZHIHU_COOKIE=

# 日志输出级别：trace | debug | info | warn | error
LOG_LEVEL=info
