    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "got": "^14.4.5",
    "jsdom": "^26.0.0",
    "mime-types": "^2.1.35",
    "sanitize-html": "^2.14.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.13.4",
    "@types/sanitize-html": "^2.13.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
