{
  "name": "article-extractor-api",
  "version": "1.0.0",
  "description": "Universal article content and image extraction API for rich-text editors (WeChat Official Accounts, Zhihu, Juejin, CSDN, and generic web articles).",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx test/extract.test.ts"
  },
  "keywords": [
    "article-extractor",
    "web-scraper",
    "rich-text",
    "wechat-article",
    "readability",
    "image-proxy",
    "api"
