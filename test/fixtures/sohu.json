                   </script>\n        <script src=\"//js.sohu.com/pv.js\" defer=\"defer\"></script><script src=\"https://g1.itc.cn/msfe-pcarti-prod/300000000000/assets/js/runtime~main_article-1d38544.js\" defer=\"defer\"></script><script src=\"https://g1.itc.cn/msfe-pcarti-prod/300000000000/assets/js/vendors-5a2b0ba.js\" defer=\"defer\"></script><script src=\"https://g1.itc.cn/msfe-pcarti-prod/300000000000/assets/js/72030-b9d8a4f.js\" defer=\"defer\"></script><script src=\"https://g1.itc.cn/msfe-pcarti-prod/300000000000/assets/js/81008-3bf6299.js\" defer=\"defer\"></script><script src=\"https://g1.itc.cn/msfe-pcarti-prod/300000000000/assets/js/main_article-e1b389e.js\" defer=\"defer\"></script>        <script>\ntry {\n        var cfgs = {\n        channel_id: \"43\",\n        news_id: \"1087663110\",\n        cms_id: \"$mpNews.cmsId\",\n        hasLatex: \"\",\n        media_id: \"120146415\",\n        passport: \"213655\",\n        weboUrl: \"https://mp.sohu.com/profile?xpt=MWJmNTdjZjYtMTRiMi00NWI2LWE2ZDMtY2I1NmRhNTNmNDQ0\",\n        title: \"“上岸”屡受挫，女生养青蛙缓解焦虑\",\n        channel_url: \"//society.sohu.com\",\n                excerpt: \"或许你还对那只曾在八年前全网刷屏过的旅行青蛙有印象，后来它风光不再。今年9月，《旅行青蛙·中国之旅》宣布即将停止运营，关闭服务器，那些原本安静的养蛙人，突然从自己的世界冒出头来，开始讲述他们和这只青蛙的故事。在漫长的时光里，像朋友，像电子宠物，像儿女甚至父母，青蛙不说话，陪他们跨过人生重要的坎。\",\n                cover: \"//q1.itc.cn/q_70/images01/20261014/c560d1e8c022406eac28949f6405fa37.jpeg\",\n        integralLevel: \"7\",\n        categoryId: \"1453\",\n        //abData_fd用于abtest\n        abData: \"\",\n        abData_discuss: \"\", // 讨论\n        abData_fd: \"\",\n        abData_tw: \"\",\n        originalId: \"$mpNews.originalId\",\n        originalStatus: \"1\",\n        isBaiDuAd: \"\",\n        isPure: \"${pure}\",\n        reprint: false,\n        reprintSign: \"\",\n        secureScore: '100',\n        sGrade: '0',\n        hideAd: '',\n        hiddenRatio: '82',\n        keywords: \"[什么, 三叶草, 青蛙, 那只, 上岸, 游戏, 旅行, 朋友, 世界, 时候, 见闻记录, 青蛙, 陆大龙, 游戏, 旅行青蛙, 宣纸]\",\n      